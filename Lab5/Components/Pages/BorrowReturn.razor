@page "/borrow"
@inject Lab5WebApplication.Services.LibraryService LibraryService

<h3>Borrow & Return Books</h3>

<div class="row">
    <div class="col-md-6">
        <h4>Borrow a Book</h4>
        <div class="mb-3">
            <label>Select User:</label>
            <select class="form-control" @bind="selectedUserId">
                <option value="0">-- Select User --</option>
                @foreach (var user in LibraryService.GetUsers())
                {
                    <option value="@user.Id">@user.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Select Book:</label>
            <select class="form-control" @bind="selectedBookId">
                <option value="0">-- Select Book --</option>
                @foreach (var book in LibraryService.GetBooks())
                {
                    <option value="@book.Id">@book.Title by @book.Author</option>
                }
            </select>
        </div>
        <button class="btn btn-success" @onclick="Borrow">Borrow Book</button>
    </div>

    <div class="col-md-6">
        <h4>Borrowed Books List</h4>
        @foreach (var entry in LibraryService.GetBorrowedBooks().Where(e => e.Value.Any()))
        {
            <div class="card mb-2 p-2">
                <strong>User: @entry.Key.Name</strong>
                <ul>
                    @foreach (var book in entry.Value)
                    {
                        <li>
                            @book.Title
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Return(book, entry.Key.Id)">Return Book</button>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@code {
    private int selectedUserId;
    private int selectedBookId;

    private void Borrow()
    {
        if (selectedUserId > 0 && selectedBookId > 0)
        {
            LibraryService.BorrowBook(selectedUserId, selectedBookId);
            selectedBookId = 0;
            selectedUserId = 0;
        }
    }

    private void Return(Book book, int userId)
    {
        LibraryService.ReturnBook(book, userId);
    }
}
